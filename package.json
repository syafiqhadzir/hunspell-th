{
    "name": "hunspell-th",
    "version": "0.1.0",
    "description": "Thai (th_TH) dictionary extension for Hunspell. Released under GPLv3.",
    "main": "index.js",
    "scripts": {
        "test": "mocha test/**/*.spec.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "lint-staged": "lint-staged",
        "prepare": "husky install"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml}": [
            "prettier --write"
        ]
    },
    "keywords": [
        "hunspell",
        "thai",
        "th_TH",
        "dictionary",
        "spell-checker",
        "wordlist"
    ],
    "files": [
        "th_TH.aff",
        "th_TH.dic",
        "index.js"
    ],
    "author": "Syafiq Hadzir <syafiqhadzir@live.com.my> (https://syafiqhadzir.dev)",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/SyafiqHadzir/Hunspell-TH/issues"
    },
    "homepage": "https://github.com/SyafiqHadzir/Hunspell-TH",
    "repository": {
        "type": "git",
        "url": "https://github.com/SyafiqHadzir/Hunspell-TH.git"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.0.0",
        "@commitlint/config-conventional": "^19.0.0",
        "@eslint/js": "^9.39.2",
        "chai": "^4.4.1",
        "eslint": "^9.0.0",
        "globals": "^16.5.0",
        "husky": "^9.0.11",
        "lint-staged": "^15.2.2",
        "mocha": "^10.4.0",
        "nspell": "^2.1.5",
        "prettier": "^3.2.5"
    }
}
