{
    "name": "hunspell-th",
    "version": "0.1.0",
    "description": "Thai (th_TH) dictionary extension for Hunspell. Released under GPLv3.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "npm run build",
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "lint": "biome check .",
        "lint:fix": "biome check . --write",
        "format": "biome format . --write",
        "lint-staged": "lint-staged",
        "prepare": "husky install",
        "changeset": "changeset",
        "sort-dict": "tsx scripts/sort-dict.ts"
    },
    "lint-staged": {
        "*.{js,ts,cjs,mjs,d.cts,d.mts,json,jsonc}": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "keywords": [
        "hunspell",
        "thai",
        "th_TH",
        "dictionary",
        "spell-checker",
        "wordlist"
    ],
    "files": [
        "th_TH.aff",
        "th_TH.dic",
        "dist"
    ],
    "author": "Syafiq Hadzir <syafiqhadzir@live.com.my> (https://syafiqhadzir.dev)",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/SyafiqHadzir/Hunspell-TH/issues"
    },
    "homepage": "https://github.com/SyafiqHadzir/Hunspell-TH",
    "repository": {
        "type": "git",
        "url": "https://github.com/SyafiqHadzir/Hunspell-TH.git"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.10",
        "@changesets/cli": "^2.29.8",
        "@commitlint/cli": "^19.0.0",
        "@commitlint/config-conventional": "^19.0.0",
        "@types/node": "^25.0.3",
        "@vitest/coverage-v8": "^4.0.16",
        "husky": "^9.0.11",
        "lint-staged": "^15.2.2",
        "nspell": "^2.1.5",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.16"
    }
}
